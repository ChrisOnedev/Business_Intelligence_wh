/*
	A STORAGE PROCEDURED THAT
	BULK INSERT: direct insert from crm/erp csv sources
	(The erp/crm sources have been moved)
*/


CREATE OR ALTER PROCEDURE [bronze].[load_bronze]
AS
BEGIN

	BEGIN TRY
